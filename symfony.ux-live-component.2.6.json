{
    "manifests": {
        "symfony/ux-live-component": {
            "manifest": {
                "bundles": {
                    "Symfony\\UX\\LiveComponent\\LiveComponentBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/routes/ux_live_component.yaml": {
                    "contents": [
                        "live_component:",
                        "    resource: '@LiveComponentBundle/config/routes.php'",
                        "    prefix: '/_components'",
                        "    # adjust prefix to add localization to your components",
                        "    #prefix: '/{_locale}/_components'",
                        "    defaults:",
                        "        # Thelia\\Core\\EventListener\\ViewListener answers kernel.view with a themed",
                        "        # view. Without this flag it replaces every component response with a 404,",
                        "        # since /_components/... matches no front-office view.",
                        "        ignore_thelia_view: true"
                    ],
                    "executable": false
                }
            },
            "ref": "f4785f1e9793ecaa94e49f00032049fff912e8b5"
        }
    }
}
